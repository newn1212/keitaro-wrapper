# Скопируйте этот файл в .env и впишите свои значения
KEITARO_URL=https://tlk.host
KEITARO_API_KEY=сюда_вставьте_API_ключ_из_Keitaro

# Куда сохранять локальную базу (SQLite, ничего устанавливать не нужно)
DATABASE_URL=sqlite:///./app.db

# Что подставлять в каждую создаваемую кампанию (ищется по имени через API)
DOMAIN_NAME=in.posdk.xyz
GROUP_NAME=FORTESTS
SOURCE_NAME=FORTESTS

# Необязательно: требуемый префикс названия, например test_ivanov_
NAME_PREFIX=
